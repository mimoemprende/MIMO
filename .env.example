# Copie este archivo como .env.local y complete con los datos de SU proyecto Supabase.
# Supabase Dashboard → Project Settings → API.
# La "anon key" es pública por diseño: la seguridad la garantizan las políticas RLS del archivo SQL.
# NUNCA ponga aquí la "service_role key".
VITE_SUPABASE_URL=https://SU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=su-anon-key-publica

# URL pública del sitio (se usa para construir los enlaces/QR de seguimiento).
# En local: http://localhost:5173  ·  En producción: https://su-dominio.com
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Ruta base del despliegue. "/" para dominio propio, Vercel o Netlify.
# Para GitHub Pages de proyecto use "/<nombre-del-repositorio>/" (lo configura el workflow automáticamente).
VITE_BASE_PATH=/
